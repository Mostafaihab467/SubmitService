<Window x:Class="SubmitServ.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Submit Service" Height="600" Width="1100" 
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowGradient}">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
        </Style>
    </Window.Styles>
    
    <Grid>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar with Theme Toggle -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Submit Service" FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <Button x:Name="ThemeToggleBtn" Content="☀️  Light Mode" 
                        Width="130" HorizontalAlignment="Right" DockPanel.Dock="Right"
                        Click="ThemeToggle_Click" Background="#444444" FontSize="12"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Settings Panel with Gradient Border -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" CornerRadius="8" 
                        BorderThickness="1" BorderBrush="{DynamicResource PanelBorder}" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Header -->
                            <TextBlock Text="Configuration Settings" FontSize="16" FontWeight="Bold" 
                                       Margin="0,0,0,16" Foreground="{DynamicResource AccentColor}"/>
                            
                            <TextBlock Text="client_id" Margin="0,0,0,4" 
                                       Foreground="{DynamicResource LabelForeground}" FontWeight="SemiBold"/>
                            <TextBox x:Name="client_id" Text="5ee13adf-d438-48ac-b6f9-d30c2b0a4a62" Margin="0,0,0,12" />

                            <TextBlock Text="client_secret" Margin="0,0,0,4" 
                                       Foreground="{DynamicResource LabelForeground}" FontWeight="SemiBold"/>
                            <TextBox x:Name="client_secret" Text="d2786429-f801-4b93-a709-353090a5a264" Margin="0,0,0,12" />

                            <TextBlock Text="posserial" Margin="0,0,0,4" 
                                       Foreground="{DynamicResource LabelForeground}" FontWeight="SemiBold"/>
                            <TextBox x:Name="posserial" Text="E1EA0240-3140-49CF-AFA6-25EC735E018A" Margin="0,0,0,12" />

                            <TextBlock Text="pososversion" Margin="0,0,0,4" 
                                       Foreground="{DynamicResource LabelForeground}" FontWeight="SemiBold"/>
                            <TextBox x:Name="pososversion" Text="Linux" Margin="0,0,0,12" />

                            <TextBlock Text="qrURL" Margin="0,0,0,4" 
                                       Foreground="{DynamicResource LabelForeground}" FontWeight="SemiBold"/>
                            <TextBox x:Name="qrURLText" Text="https://invoicing.eta.gov.eg/receipts/search/" Margin="0,0,0,12" />

                            <TextBlock Text="limit" Margin="0,0,0,4" 
                                       Foreground="{DynamicResource LabelForeground}" FontWeight="SemiBold"/>
                            <TextBox x:Name="Limit" Text="10" Margin="0,0,0,12" />

                            <TextBlock Text="Server Connection String" Margin="0,0,0,4" 
                                       Foreground="{DynamicResource LabelForeground}" FontWeight="SemiBold"/>
                            <TextBox x:Name="Server" TextWrapping="Wrap" AcceptsReturn="True" Height="90" 
                                     Text="Server=.;Database=TaxTech_Production;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=true;" 
                                     Margin="0,0,0,16" />

                            <!-- Control Buttons -->
                            <TextBlock Text="Controls" FontSize="14" FontWeight="Bold" 
                                       Margin="0,0,0,12" Foreground="{DynamicResource AccentColor}"/>
                            
                            <WrapPanel Margin="0,0,0,12">
                                <Button x:Name="Start_Status_Service" Content="Start Service" Width="220" 
                                        Margin="0,0,8,8" Click="Start_Status_Service_Click" />
                            </WrapPanel>

                            <WrapPanel Margin="0,0,0,12">
                                <Button x:Name="Stop" Content="Stop" Width="105" 
                                        Margin="0,0,8,8" Click="Stop_Click" />
                                <Button x:Name="Clear" Content="Clear Log" Width="105" 
                                        Margin="0,0,8,8" Click="Clear_Click" />
                            </WrapPanel>

                            <WrapPanel Margin="0,0,0,12">
                                <Button x:Name="SaveSettings" Content="💾 Save Settings" Width="220" 
                                        Click="SaveSettings_Click" Background="#107C10"/>
                            </WrapPanel>

                            <Button x:Name="button1" Content="One Batch" Width="220" Height="40" 
                                    Margin="0,10,0,0" Click="button1_Click" Background="#D13438"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Log Panel with Stats Tracker -->
                <Border Grid.Column="2" Background="{DynamicResource PanelBackground}" CornerRadius="8" 
                        BorderThickness="1" BorderBrush="{DynamicResource PanelBorder}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Service Log" FontSize="14" FontWeight="Bold" 
                                   Margin="0,0,0,12" Foreground="{DynamicResource AccentColor}"/>
                        
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="txt_Status_Log"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Background="{DynamicResource LogBackground}"
                                     Foreground="{DynamicResource LogForeground}"
                                     FontFamily="Consolas, Courier New"
                                     FontSize="10"
                                     Text="Service ready. Configure settings and click 'Start Service'" />
                        </ScrollViewer>
                        
                        <!-- Statistics Tracker Panel -->
                        <Border Grid.Row="2" Background="{DynamicResource InputBackground}" 
                                CornerRadius="6" Padding="12" Margin="0,12,0,0"
                                BorderThickness="1" BorderBrush="{DynamicResource PanelBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Title -->
                                <TextBlock Grid.Row="0" Text="📊 Submission Statistics" FontSize="12" FontWeight="Bold" 
                                           Margin="0,0,0,8" Foreground="{DynamicResource AccentColor}"/>
                                
                                <!-- Stats Grid -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Total Submitted -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="Total" FontSize="10" Foreground="{DynamicResource LabelForeground}" 
                                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txt_TotalCount" Text="0" FontSize="20" FontWeight="Bold" 
                                                   Foreground="#4FC3F7" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Accepted -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="✓ Accepted" FontSize="10" Foreground="{DynamicResource LabelForeground}" 
                                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txt_AcceptedCount" Text="0" FontSize="20" FontWeight="Bold" 
                                                   Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Rejected -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="✗ Rejected" FontSize="10" Foreground="{DynamicResource LabelForeground}" 
                                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txt_RejectedCount" Text="0" FontSize="20" FontWeight="Bold" 
                                                   Foreground="#F44336" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Failed -->
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock Text="⚠ Failed" FontSize="10" Foreground="{DynamicResource LabelForeground}" 
                                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txt_FailedCount" Text="0" FontSize="20" FontWeight="Bold" 
                                                   Foreground="#FF9800" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Rate -->
                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                        <TextBlock Text="⚡ Rate/s" FontSize="10" Foreground="{DynamicResource LabelForeground}" 
                                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txt_Rate" Text="0.00" FontSize="20" FontWeight="Bold" 
                                                   Foreground="#9C27B0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
